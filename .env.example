# ─────────────────────────── AURA · environment ───────────────────────────
# Copy to .env and fill in. NEVER commit real secrets.

# PostgreSQL (application database — owns all user data)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ── Option A: OpenRouter model router (recommended to start) ───────────────
# Server-side only — NEVER expose this key to the client.
# Free-tier friendly: the router picks ONE best model per request with
# capability-based fallbacks (no per-prompt fan-out, no infinite retries).
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
APP_URL=                     # your deployed URL (goes to OpenRouter as referer)

# Model IDs — copy EXACT ids from https://openrouter.ai/models (they change!).
# Currently configured routing roles:
MODEL_GLM=                   # z-ai/glm-5.2:free        → PRIMARY general/agent: chat, reasoning, tools, research synthesis
MODEL_MINIMAX=               # minimax/minimax-m3:free → PRIMARY coding (ctx 1M, provider-verified)
MODEL_MINIMAX_FALLBACK=      # minimax/minimax-m2.7:free → coding fallback ONLY (used if M3 fails/429s)
MODEL_NEMOTRON_SUPER=        # nvidia/nemotron-3-super-120b-a12b:free → PRIMARY deep reasoning / complex planning
MODEL_NEMOTRON_OMNI=         # nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free → PRIMARY multimodal (image/audio/video)
MODEL_LAGUNA=                # poolside/laguna-s-2.1:free → CODING FALLBACK
MODEL_GEMMA=                 # google/gemma-4-31b-it:free → GENERAL fallback: writing, summarization
MODEL_GPT_OSS=               # optional extra (not currently configured)
MODEL_NEX=                   # optional extra (not currently configured)

# Routing matrix (rank 1 = primary):
#   general_chat:  GLM → Gemma
#   coding/debug:  MiniMax → Laguna → GLM
#   reasoning:     Nemotron Super → GLM → Gemma
#   planning:      Nemotron Super → GLM → MiniMax
#   writing:       GLM → Gemma
#   summarization: Gemma → GLM
#   agent/tools:   GLM → MiniMax → Nemotron Super
#   multimodal:    Omni → Gemma (only when provider metadata confirms the modality)
#   web research:  search runs FIRST, then synthesis — GLM (plain) / Nemotron (hard) / MiniMax (code)

# Per-model switches (all optional; these are the safe defaults):
# MODEL_GLM_ENABLED=false          # disable any model without removing its ID
# MODEL_GEMMA_TOOLS=true           # override tool-calling support
# MODEL_GEMMA_VISION=true          # ONLY after the model page confirms image input
# MODEL_NEMOTRON_OMNI_VISION=true  # same — omni multimodal is OFF until verified
# MODEL_NEMOTRON_OMNI_AUDIO=true
# MODEL_NEMOTRON_OMNI_VIDEO=true
# MODEL_NEX_STRUCTURED=true        # native JSON mode
# MODEL_GLM_REASONING=false        # reasoning capability flag
# MODEL_GLM_CONTEXT=200000         # override max context length
# MODEL_GLM_PRIORITY=1             # global fallback ordering (lower = earlier)

# ── Option B: self-hosted gateway (vLLM / Ollama / llama.cpp / TGI) ────────
# Your own OpenAI-compatible model server on YOUR GPU host. Used automatically
# when OpenRouter is not configured. Examples:
#   vLLM:      http://gpu-host:8000   (model dir served via --served-model-name)
#   Ollama:    http://gpu-host:11434  (use /v1 endpoint)
#   llama.cpp: http://gpu-host:8080
AI_BASE_URL=
AI_MODEL=                    # e.g. Qwen/Qwen2.5-14B-Instruct, llama3.1-8b, qwen2.5:7b-instruct
AI_API_KEY=                  # optional bearer token for your own gateway auth

# Optional specialized self-hosted endpoints (same gateway by default)
EMBEDDING_MODEL=             # e.g. bge-m3, nomic-embed-text — falls back to built-in sparse retrieval
VISION_MODEL=                # e.g. Qwen/Qwen2.5-VL-7B-Instruct — enables image analysis
STT_MODEL=                   # e.g. whisper-large-v3-turbo — enables server-side transcription

# ── Web search ──────────────────────────────────────────────────────────────
# Self-hosted SearXNG instance (https://docs.searxng.org). When unset, the
# backend falls back to keyless DuckDuckGo HTML search. No API keys needed either way.
SEARXNG_URL=                 # e.g. http://searxng:8080

# ── Password reset ──────────────────────────────────────────────────────────
# Self-hosting convenience: return the reset link in the API response when no
# mail service is wired up. Set to false in multi-tenant production.
EXPOSE_RESET_LINK=true

# ── Future integrations (placeholders) ─────────────────────────────────────
# STORAGE_URL=               # external object storage for large files
# NOTIFICATION_CONFIG=       # push relay (APNs/FCM via your own relay service)
# TTS_BASE_URL=              # self-hosted TTS (e.g. Kokoro / Piper server)
